{
  "name": "new-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "precommit": "npm-run-all --parallel check lint:*",
    "format": "prettier --write .",
    "add:program-note": "npx hygen program-note new",
    "prepare": "husky",
    "predev": "npm run generate:ogp",
    "prebuild": "npm run generate:ogp && npm run test:ogp",
    "generate:ogp": "node scripts/generate-ogp.mjs",
    "test:ogp": "node --test scripts/ogp/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.0",
    "sharp": "^0.34.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-meta-tags": "^5.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.100.0"
  },
  "type": "module",
  "dependencies": {
    "dayjs": "^1.11.21"
  },
  "overrides": {
    "cookie": "1.1.1",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "picomatch": "4.0.4",
    "yaml": "1.10.3"
  }
}
